    {
      "parameters": {
        "jsCode": "// Process the Google Sheets lookup results\nconst lookupResultItem = $input.first(); // Google Sheets v4 lookup returns one item or error\nconst inputDataFromExtract = $('Extract & Validate Form Data').first().json;\n\nconsole.log(\"Lookup result from Google Sheets:\", JSON.stringify(lookupResultItem.json));\n\nif (!lookupResultItem.json || Object.keys(lookupResultItem.json).length === 0) { // Check if json is empty or undefined\n  return {\n    json: {\n      ...inputDataFromExtract,\n      success: false,\n      message: \"Order ID not found in the tracking system.\",\n      errorType: \"ORDER_NOT_FOUND\",\n      orderExists: false\n    }\n  };\n}\n\nconst orderData = lookupResultItem.json;\n\nconst storedOtp = orderData.otp ? orderData.otp.toString().trim() : null;\nconst providedOtp = inputDataFromExtract.otp;\nconst rowId = orderData.rowNumber || inputDataFromExtract.rowId; // Prefer rowNumber from lookup\n\nconst otpMatches = storedOtp === providedOtp;\n\nreturn {\n  json: {\n    ...inputDataFromExtract,\n    ...orderData, // data from the sheet (like stored OTP, original address etc.)\n    orderId: inputDataFromExtract.orderId, // Ensure this comes from the input form\n    rowId, // Corrected rowId\n    providedOtp,\n    storedOtp,\n    otpMatches,\n    orderExists: true,\n    deliveryTime: new Date().toISOString()\n  }\n};"
      },
