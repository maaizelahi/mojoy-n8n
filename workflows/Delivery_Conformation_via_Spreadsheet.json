    {
      "parameters": {
        "jsCode": "// Process the Google Sheets lookup results\nconst lookupResults = $input.first().json;\nconsole.log(\"Maaiz here:\", lookupResults);\nconst inputData = $input.first();\n\n// Check if any results were found\nif (!lookupResults) {\n  return {\n    json: {\n      success: false,\n      message: \"Order not found in the tracking system.\",\n      orderExists: false,\n      orderId: inputData.json.orderId\n    }\n  };\n}\n\n// Get the first matching order (assuming orderId is unique)\nconst orderData = lookupResults;\n\n// Extract the stored OTP and other order information\nconst storedOtp = orderData.otp ? orderData.otp.toString().trim() : null;\nconst providedOtp = inputData.json.otp;\nconst rowId = orderData.rowNumber || inputData.json.rowId;\n\n// Verify OTP\nconst otpMatches = storedOtp === providedOtp;\n\n// Pass along original input data for updates\nreturn {\n  json: {\n    ...orderData,\n    orderId: inputData.json.orderId,\n    deliveryPersonName: inputData.json.deliveryPersonName,\n    deliveryStatus: inputData.json.deliveryStatus,\n    deliveryNotes: inputData.json.deliveryNotes,\n    rowId,\n    providedOtp,\n    storedOtp,\n    otpMatches,\n    orderExists: true,\n    deliveryTime: new Date().toISOString()\n  }\n};"
      },
