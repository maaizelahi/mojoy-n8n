    {
      "parameters": {
        "jsCode": "// Extract data from the spreadsheet edit webhook payload\n// The format from Google Apps Script will be different from a direct form submission\nconst payload = $input.first().json;\n\n// Log the incoming data structure for debugging\nconsole.log(\"Incoming webhook payload:\", JSON.stringify(payload));\n\n// Extract the form response data\n// Assuming the Apps Script sends the row data in a structured format\nlet formData;\nif (payload.body) {\n  // If data is nested in body (common webhook structure)\n  formData = typeof payload.body === 'string' ? JSON.parse(payload.body) : payload.body;\n} else {\n  // If data is at the top level\n  formData = payload;\n}\n\n// Extract the required fields\n// Note: Field names should match exactly what's coming from the Google Form/Sheet\nconst orderId = formData.orderId || formData['Order ID'] || \"\";\nconst deliveryPersonName = formData.deliveryPersonName || formData['Delivery Person Name'] || \"\";\nconst otp = formData.otp || formData['OTP'] || \"\";\nconst deliveryStatus = formData.deliveryStatus || formData['Delivery Status'] || \"Delivered\";\nconst deliveryNotes = formData.deliveryNotes || formData['Delivery Notes'] || \"\";\n\n// Extract row information if available\nconst rowId = formData.rowId || formData.row || null;\nconst spreadsheetId = formData.spreadsheetId || null;\n\n// Validate required fields\nlet validInputs = Boolean(orderId && deliveryPersonName && otp);\nlet validationMessage = validInputs ? \"All required fields present\" : \"Missing required fields\";\n\n// Return the extracted and validated data\nreturn {\n  json: {\n    orderId: orderId.toString().trim(),\n    deliveryPersonName: deliveryPersonName.toString().trim(),\n    otp: otp.toString().trim(),\n    deliveryStatus,\n    deliveryNotes,\n    rowId,\n    spreadsheetId,\n    timestamp: new Date().toISOString(),\n    validInputs,\n    validationMessage\n  }\n};"
      },
