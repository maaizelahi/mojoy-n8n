        "jsCode": "// Create success response for delivery person\nreturn {\n  json: {\n    success: true,\n    message: \"Delivery confirmed successfully! The order has been marked as completed.\",\n    details: {\n      orderId: $('Extract Form Response Data').first().json.orderId,\n      deliveryPerson: $('Extract Form Response Data').first().json.deliveryPersonName,\n      timestamp: $('Extract Form Response Data').first().json.timestamp,\n      status: $('Extract Form Response Data').first().json.deliveryStatus\n    }\n  }\n};"
