      "parameters": {
        "jsCode": "// Extract data from the webhook payload (e.g., from Google Apps Script or a form)\nconst input = $input.first().json;\nlet formData;\n\ntry {\n  if (input.body) {\n    formData = typeof input.body === 'string' ? JSON.parse(input.body) : input.body;\n  } else {\n    formData = input; // Assuming data is at the top level if no 'body' property\n  }\n} catch (e) {\n  console.error(\"Error parsing formData:\", e, \"Input was:\", JSON.stringify(input));\n  return { json: { success: false, message: \"Invalid JSON payload.\", errorType: \"INVALID_PAYLOAD\" } };\n}\n\n// Extract and validate required fields\nconst orderId = (formData.orderId || formData['Order ID'] || '').toString().trim();\nconst deliveryPersonName = (formData.deliveryPersonName || formData['Delivery Person Name'] || '').toString().trim();\nconst otp = (formData.otp || formData['OTP'] || '').toString().trim();\n\nlet errors = [];\nif (!orderId) errors.push(\"Order ID is required.\");\nif (!deliveryPersonName) errors.push(\"Delivery Person Name is required.\");\nif (!otp) errors.push(\"OTP is required.\");\n\nif (errors.length > 0) {\n  return {\n    json: {\n      success: false,\n      message: \"Validation failed: \" + errors.join(' '),\n      errorType: \"INVALID_INPUT\",\n      validationDetails: errors.join(' '),\n      validInputs: false\n    }\n  };\n}\n\n// Optional fields\nconst deliveryStatus = formData.deliveryStatus || formData['Delivery Status'] || \"Delivered\";\nconst deliveryNotes = formData.deliveryNotes || formData['Delivery Notes'] || \"\";\nconst rowId = formData.rowId || formData.row || null;\nconst spreadsheetId = formData.spreadsheetId || null; // Might be useful for context\n\nreturn {\n  json: {\n    orderId,\n    deliveryPersonName,\n    otp,\n    deliveryStatus,\n    deliveryNotes,\n    rowId,\n    spreadsheetId,\n    timestamp: new Date().toISOString(),\n    validInputs: true,\n    validationMessage: \"All required fields present\"\n  }\n};"
      },
