      "parameters": {
        "jsCode": "// Generate a 6-digit OTP\nconst otp = Math.floor(100000 + Math.random() * 900000);\n\n// Access the first input item\nconst data = $input.first().json.body;\n\n// Safely extract billing and shipping information\nconst billing = data.billing || {};\nconst shipping = data.shipping || {};\n\n// Construct the formatted address\nconst addressParts = [\n  shipping.address_1,\n  shipping.city,\n  shipping.state,\n  shipping.postcode\n].filter(part => part).join(', ');\n\n// Format data for the next node\nreturn {\n  json: {\n    orderId: data.order_id || null,\n    customerName: `${billing.first_name || ''} ${billing.last_name || ''}`.trim(),\n    phone: (billing.phone || '').replace(/\\D/g, '').replace(/^0+|^91+/, ''),\n    email: billing.email || '',\n    otp: otp.toString(),\n    status: data.status || 'Out for Delivery',\n    timestamp: new Date().toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata' }),\n    address: addressParts,\n    // items: data.items || []\n  }\n};\n"
      },
